# Database. Use a URL-safe hex password, for example: openssl rand -hex 32
POSTGRES_DB=auction_db
POSTGRES_USER=auction
POSTGRES_PASSWORD=replace_with_a_random_hex_secret

# Generate both secrets separately with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_hex_secret
OTP_HASH_SECRET=replace_with_another_random_hex_secret

# Email delivery is required for login codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO=

# Use the email address that will be registered as the first administrator
ADMIN_USER=admin@example.com

# Public HTTP port on the server
WEB_PORT=80
